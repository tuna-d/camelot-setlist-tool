# Camelot Setlist — ortam değişkenleri
# Bu dosyayı .env olarak kopyala (yerel geliştirme) ve/veya değerleri
# Vercel → Project → Settings → Environment Variables altına gir.
# Hiçbiri zorunlu değil: uygulama hepsi eksikken de çalışır, aşağıda ne kaybettiğin yazıyor.

# ——— Supabase (giriş ve kayıt) ———
# Supabase → Project → Settings → API sayfasındaki iki değer.
# İkisi de tarayıcıya gider, gizli değildir; veriyi koruyan şey Row Level Security.
# Yoksa: giriş kapalı kalır, uygulama misafir kipinde çalışır (her şey yalnızca tarayıcıda).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Yalnızca sunucu tarafı: haftalık katalog tazelemesi bununla yazar (RLS'i aşar).
# Supabase → Settings → API → service_role key. Bunu asla tarayıcıya verme.
# Yoksa: tazelenen katalog veritabanına yazılamaz, uygulama public/catalog.json'a düşer.
SUPABASE_SERVICE_ROLE_KEY=

# ——— Diğer servisler ———

# Tek parça araması (GetSongBPM). Ücretsiz anahtar: https://getsongbpm.com/api
# Yoksa: "internette ara" düğmesi sonuç yerine "anahtar tanımlı değil" mesajı verir,
# kütüphane ve keşif katalogu araması çalışmaya devam eder.
GETSONGBPM_API_KEY=

# Haftalık katalog tazelemesini korur; Vercel cron bunu Authorization başlığında gönderir.
# Kendin üret: `openssl rand -hex 32`
# Yoksa: /api/catalog?refresh=1 hiç çalışmaz (tazeleme kapalı), okuma etkilenmez.
CRON_SECRET=
